{
  "name": "tiny-turbo-gp",
  "version": "0.1.0",
  "private": true,
  "description": "A cute pixel-art 2D top-down racing game with Q-style cars, built with Phaser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "node --no-warnings scripts/simulate.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
